{
    "name": "drupal/recommended-project",
    "description": "Project template for Drupal 9 projects with a relocated document root",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "composer/installers": "^2.0",
        "cweagans/composer-patches": "^1.7",
        "drupal/admin_toolbar": "^3.0",
        "drupal/block_class": "^4.0",
        "drupal/bootstrap5": "^4.0",
        "drupal/colorbox": "^2.1",
        "drupal/core-composer-scaffold": "^10",
        "drupal/core-project-message": "^10",
        "drupal/core-recommended": "^10",
        "drupal/easy_breadcrumb": "^2.0",
        "drupal/eva": "^3.1",
        "drupal/field_formatter_class": "^1.5",
        "drupal/field_group": "^3.2",
        "drupal/field_label": "^1.0",
        "drupal/filefield_paths": "dev-1.x#b0a6ac5",
        "drupal/focal_point": "^2.1",
        "drupal/paragraphs": "^1.13",
        "drupal/pathauto": "^1.8",
        "drupal/realname": "^2.0",
        "drupal/scrollup": "^3.0",
        "drupal/svg_image": "^3.0",
        "drupal/taxonomy_manager": "^2.0",
        "drupal/token": "^1.10",
        "drupal/token_filter": "^2.1",
        "drupal/userprotect": "^1.4",
        "drupal/views_bootstrap": "5.5.0-alpha1",
        "drush/drush": "^12",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/console-extend-plugin": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "wikimedia/composer-merge-plugin": true,
            "wikimedia/composer-installers": true
        },
        "audit": {
            "block-insecure": false
        }
    },
    "extra": {
        "enable-patching": true,
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        }
    },
    "require-dev": {
        "drupal/upgrade_status": "^4.3"
    }
}
